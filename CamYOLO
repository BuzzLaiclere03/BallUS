import cv2
import numpy as np
from picamera2 import Picamera2

# Charger le fichier des classes (coco.names) contenant les classes d'objets que YOLO peut détecter
with open("coco.names", "r") as f:
    classes = [line.strip() for line in f.readlines()]

# Charger le modèle YOLO (configuration et poids)
net = cv2.dnn.readNet("yolov4.weights", "yolov4.cfg")

# Spécifier les couches de sortie du modèle YOLO
layer_names = net.getLayerNames()
output_layers = [layer_names[i - 1] for i in net.getUnconnectedOutLayers()]

# Initialiser la caméra Pi
picam2 = Picamera2()
#picam2.configure(picam2.create_preview_configuration(main={"size": (640, 480)}))
picam2.configure(picam2.create_preview_configuration(raw={"size": (1640, 1232)},main={"format": 'RGB888', "size": (1640, 1232)}))
picam2.start()

while True:
    # Capture d'une image depuis la caméra Pi
    frame = picam2.capture_array()
    
    # Prétraitement de l'image pour YOLO
    height, width, channels = frame.shape
    blob = cv2.dnn.blobFromImage(frame, 0.00392, (416, 416), (0, 0, 0), True, crop=False)
    net.setInput(blob)
    
    # Faire une prédiction sur l'image
    detections = net.forward(output_layers)

    class_ids = []
    confidences = []
    boxes = []

    for out in detections:
        for detection in out:
            scores = detection[5:]
            class_id = np.argmax(scores)
            confidence = scores[class_id]
            
            if confidence > 0.5:
                center_x = int(detection[0] * width)
                center_y = int(detection[1] * height)
                w = int(detection[2] * width)
                h = int(detection[3] * height)
                
                x = int(center_x - w / 2)
                y = int(center_y - h / 2)
                
                boxes.append([x, y, w, h])
                confidences.append(float(confidence))
                class_ids.append(class_id)

    # Appliquer la suppression des non-maxima
    indexes = cv2.dnn.NMSBoxes(boxes, confidences, 0.5, 0.4)

    if len(indexes) > 0:
        for i in indexes.flatten():
            x, y, w, h = boxes[i]
            label = str(classes[class_ids[i]])
            confidence = str(round(confidences[i], 2))
            cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)
            cv2.putText(frame, f"{label} {confidence}", (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

    # Afficher l'image avec les objets détectés
    cv2.imshow("YOLO Object Detection", frame)

    # Quitter avec 'q'
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# Fermer la caméra et la fenêtre OpenCV
cv2.destroyAllWindows()
picam2.close()
