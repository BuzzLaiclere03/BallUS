
import numpy as np
import serial
import cv2
from picamera2 import Picamera2
from ultralytics import YOLO
import time



# Champs de vision (Field of View) de la PiCamera3
FOV_x = 66  # FOV horizontal en degrés
FOV_y = 41  # FOV vertical en degrés

width = 1640 #640 et 480 1280
height = 1640


detectedObject = 0;

# Configuration de la connexion série avec l'Arduino
arduino = serial.Serial('/dev/ttyACM0', 9600)  # Remplace '/dev/ttyUSB0' par le port de ton Arduino
time.sleep(2)  # Temps d'attente pour que la connexion série soit établie

def send_angles_to_arduino(yaw, pitch):
    # Envoie les valeurs de yaw et pitch au format flottant via le port série
    arduino.write(f"{yaw:.2f},{pitch:.2f}\n".encode())
    
def get_rotation_angles(x_center, y_center):
    """
    Calcule les angles de rotation nécessaires pour suivre une cible détectée.
    """
    x_img = width / 2
    y_img = height / 2

    delta_x = x_center - x_img
    delta_y = y_center - y_img

    theta_yaw = (delta_x / width) * FOV_x
    theta_pitch = (delta_y / height) * FOV_y

    return theta_yaw, theta_pitch

# Set up the camera with Picam
picam2 = Picamera2()
picam2.preview_configuration.main.size = (width, height)
picam2.preview_configuration.main.format = "RGB888"
picam2.preview_configuration.align()
picam2.configure("preview")
picam2.start()

# Load YOLOv8
model = YOLO("yolov8n_ncnn_model") #yolov8n.pt

# Variables pour mesurer la vitesse de traitement
prev_time = time.time()


while True:
    
    frame_start_time = time.time()  # Début du traitement de la frame
    
    # Capture a frame from the camera
    frame = picam2.capture_array()
    
    # Inversion verticale de l'image
    flipped_frame = cv2.flip(frame, 0)
    
    # Run YOLO model on the captured frame and store the results
    results = model.predict(flipped_frame, imgsz = 320)
    detections = results[0]
    
    x_center = []
    y_center = []

    for det in detections.boxes:
        x, y, w, h = det.xywh[0]  # Coordonnées du centre et dimensions
        conf = det.conf[0].item()  # Confiance
        cls = int(det.cls[0].item())  # Classe détectée

        if conf > 0.5 and cls == detectedObject:
            x, y, w, h = map(int, [x, y, w, h])
            cv2.rectangle(flipped_frame, (x - w // 2, y - h // 2), 
                            (x + w // 2, y + h // 2), (0, 255, 0), 2)
            cv2.putText(flipped_frame, f"{cls} {conf:.2f}", (x, y - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
            
            x_center.append(x)
            y_center.append(y)
            
            cv2.circle(flipped_frame, (x, y), 5, (0, 0, 255), -1)
    
        if x_center:
            x_center_moy = int(np.mean(x_center))
            y_center_moy = int(np.mean(y_center))


            yaw, pitch = get_rotation_angles(x_center_moy, y_center_moy)
            send_angles_to_arduino(yaw, pitch)

            cv2.circle(flipped_frame, (x_center_moy, y_center_moy), 5, (0, 0, 255), -1)
    
    # Output the visual detection data, we will draw this on our camera preview window
    #annotated_frame = detections[0].plot()
    
    # Calculer la vitesse de la frame
    frame_end_time = time.time()
    frame_time = frame_end_time - frame_start_time
    fps = 1 / frame_time if frame_time > 0 else 0

    # Afficher les FPS sur l'image
    cv2.putText(flipped_frame, f"FPS: {fps:.1f}", (10, 30), 
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 0, 0), 2)


    # Display the resulting frame
    cv2.imshow("YOLO Object Tracking", flipped_frame)

    # Exit the program if q is pressed
    if cv2.waitKey(1) == ord("q"):
        break

# Close all windows
cv2.destroyAllWindows()

